<?xml version="1.0" encoding="utf-8"?>
<!--
    Aturan backup untuk Android 11 dan lebih lama.
    DataStore dikecualikan agar token sesi tidak disalin ke backup.
-->
<full-backup-content>
    <!-- Kecualikan seluruh folder datastore agar token tidak masuk backup -->
    <exclude domain="file" path="datastore/" />
</full-backup-content>