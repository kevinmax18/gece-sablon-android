<?xml version="1.0" encoding="utf-8"?>
<!--
    Aturan ekstraksi data untuk Android 12+ (API 31+).
    DataStore dikecualikan agar token sesi tidak disalin ke cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Kecualikan seluruh folder datastore agar token tidak masuk cloud backup -->
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <!-- Kecualikan juga saat transfer perangkat ke perangkat baru -->
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>